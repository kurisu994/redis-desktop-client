{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "opener:allow-open-url",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write"
  ]
}
